{
    "openapi": "3.0.0",
    "info": {
        "title": "Laravel Backend API V1",
        "description": "Documentação da API REST (Docker + Laravel)",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Servidor Local Docker"
        }
    ],
    "paths": {
        "/api/v1/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Verifica o status da API",
                "description": "Endpoint público que retorna status 200 indicando que a API está funcionando.",
                "operationId": "37818e1230725e445eeda77a18110789",
                "responses": {
                    "200": {
                        "description": "API funcionando normalmente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "example": "up"
                                                }
                                            }
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "API está funcionando."
                                        },
                                        "status": {
                                            "type": "integer",
                                            "example": 200
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno do servidor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "data": {
                                            "type": "object",
                                            "example": null
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Erro interno do servidor."
                                        },
                                        "status": {
                                            "type": "integer",
                                            "example": 500
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/status": {
            "get": {
                "tags": [
                    "Status"
                ],
                "summary": "Verifica o status da API",
                "operationId": "9ac66e9225a35c856de63c6d33e00195",
                "responses": {
                    "200": {
                        "description": "API is running"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Health",
            "description": "Health"
        },
        {
            "name": "Status",
            "description": "Status"
        }
    ]
}